{
  "manifest_version": 3,
  "name": "RAASTA Application Assistant",
  "version": "1.0",
  "description": "Helps citizens autofill official government forms based on their RAASTA journey.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["ui/styles.css"],
      "js": [
        "api/raasta_client.js",
        "content/form_detector.js",
        "content/field_mapper.js",
        "content/autofill.js",
        "content/vision_fallback.js",
        "ui/floating_widget.js",
        "content/content.js"
      ]
    }
  ],
  "action": {
    "default_title": "RAASTA Assistant"
  }
}
